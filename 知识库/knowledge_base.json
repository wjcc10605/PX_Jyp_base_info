  "业务流程": {
    "分期业务完整流程": [
      {
        "阶段": 1,
        "名称": "浏览",
        "描述": "用户在平台上浏览分月付商品",
        "来源表": "yj_new_dw.dws_gio_event_di / yj_new_dw.dws_track_gio_jyp_customer_product_di",
        "标识": "is_finance = 1 或浏览过金融商品"
      },
      {
        "阶段": 2,
        "名称": "下单",
        "描述": "用户点击下单，产生订单但未完成支付",
        "来源表": "yj_new_dw.dws_pxb7_trade_order_item_summary_df",
        "标识": "order_item_status_code NOT IN (4) 或有order_id但未完单"
      },
      {
        "阶段": 3,
        "名称": "支付",
        "描述": "用户完成支付",
        "来源表": "yj_new_dw.dws_pxb7_trade_order_item_summary_df",
        "标识": "order_item_status_code = 1 或 2"
      },
      {
        "阶段": 4,
        "名称": "换绑",
        "描述": "游戏账号换绑操作",
        "来源表": "yj_new_dw.dwd_pxb7_trade_order_item_df",
        "标识": "receipt_status_code = 3"
      },
      {
        "阶段": 5,
        "名称": "完单",
        "描述": "订单完成，交易成功",
        "来源表": "yj_new_dw.dws_pxb7_trade_order_item_summary_df",
        "标识": "order_item_status_code = 4"
      }
    ]
  },
  "用户分层": {
    "描述": "分期业务用户生命周期分层，仅针对分期用户",
    "分层逻辑": [
      {
        "层级": 0,
        "名称": "浏览用户",
        "定义": "浏览过分期商品的用户",
        "来源表": "yj_new_dw.dws_track_gio_jyp_customer_product_di / yj_new_dw.dws_gio_event_di",
        "条件": "浏览过 is_finance = 1 的商品 或 event_key 包含金融商品浏览"
      },
      {
        "层级": "临阶",
        "名称": "下单未完单用户",
        "定义": "有过下单行为但没有完成订单的用户",
        "来源表": "yj_new_dw.dws_pxb7_trade_order_item_summary_df",
        "条件": "有过 order_id 但 order_item_status_code != 4"
      },
      {
        "层级": 1,
        "名称": "未交易用户",
        "定义": "没有产生过完单交易的用户",
        "来源表": "yj_new_dw.dwd_pxb7_user_user_df",
        "条件": "不在完成订单表中 或 order_item_status_code != 4"
      },
      {
        "层级": 2,
        "名称": "新交易用户",
        "定义": "有过1单完单交易",
        "来源表": "yj_new_dw.dws_pxb7_trade_order_item_summary_df",
        "条件": "order_item_status_code = 4 AND order_count = 1"
      },
      {
        "层级": 3,
        "名称": "复购用户",
        "定义": "有过2单以上完单交易，且不属于四阶和五阶",
        "来源表": "yj_new_dw.dws_pxb7_trade_order_item_summary_df",
        "条件": "order_item_status_code = 4 AND order_count > 2"
      },
      {
        "层级": 4,
        "名称": "沉默用户",
        "定义": "有过交易但超过6个月没有交易",
        "来源表": "yj_new_dw.dws_pxb7_trade_order_item_summary_df",
        "条件": "order_item_status_code = 4 AND 180天 < 未交易天数 <= 365天"
      },
      {
        "层级": 5,
        "名称": "流失用户",
        "定义": "有过交易但超过1年没有交易",
        "来源表": "yj_new_dw.dws_pxb7_trade_order_item_summary_df",
        "条件": "order_item_status_code = 4 AND 未交易天数 > 365天"
      }
    ],
    "分期用户标识": {
      "说明": "仅针对分期(金融)用户，需要通过以下方式筛选",
      "方式1": {
        "表": "yj_new_dw.ods_pxb7_product_product_promotion_price_snapshot_df",
        "条件": "biz_type = 'finance' AND extend IS NOT NULL AND extend <> ''"
      },
      "方式2": {
        "表": "yj_new_dw.dws_pxb7_trade_order_item_summary_df",
        "条件": "finance_order_flag_code = 1"
      },
      "方式3": {
        "表": "yj_new_dw.dws_track_gio_jyp_customer_product_di",
        "条件": "is_finance = 1"
      }
    }
  },
