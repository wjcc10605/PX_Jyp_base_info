  "business_rules": [
    {
      "name": "订单状态定义",
      "rules": [
        "order_item_status_code = 4: 已成交(完单)",
        "order_item_status_code NOT IN (4): 未完单(包含下单、支付、换绑等阶段)",
        "receipt_status_code = 3: 收款成功(换绑完成)"
      ]
    },
    {
      "name": "时间范围标准",
      "rules": [
        "使用TO_CHAR函数格式化时间: TO_CHAR(create_time,'yyyymmdd')",
        "使用MAX_PT函数获取最新分区: ds = MAX_PT('表名')",
        "使用date_add(GETDATE(), -1)获取前一天"
      ]
    },
    {
      "name": "商品属性限制",
      "rules": [
        "排除bahei盒子: game_name NOT IN ('bahei盒子')",
        "排除测试游戏: game_name NOT LIKE '%测试%'",
        "价格区间: price/100 >= 1000",
        "商品状态: product_status_code = 1 AND is_show = 1"
      ]
    },
    {
      "name": "金融订单标识",
      "rules": [
        "finance_order_flag_code = 1: 金融订单",
        "biz_type = 'finance' AND extend IS NOT NULL AND extend <> '': 分月付商品",
        "is_finance = 1: 流量侧金融用户"
      ]
    },
    {
      "name": "转化率计算规则",
      "rules": [
        "商列到商详率: 商详页浏览人数 / 商品列表曝光人数",
        "商详到高意向率: 高意向点击人数 / 商详页浏览人数",
        "高意向下单率: 下单人数 / 高意向点击人数",
        "下单付款率: 付款人数 / 下单人数",
        "支付完单率: 完单人数 / 付款人数"
      ]
    },
    {
      "name": "高意向定义",
      "rules": [
        "金融商品: event_key = 'flowClick' AND page_name = '订单确认页面' AND pit_name = '号月付方案'",
        "非金融商品: event_key = 'productDetailClick' AND pit_name IN ('立即购买','咨询','议价','还价')",
        "IM消息: content REGEXP '分期|月付'"
      ]
    },
    {
      "name": "用户标识规则",
      "rules": [
        "新用户ID: IF(user_key = '$basic_userId', user_id, anonymous_user)",
        "是否PX用户: IF(user_key = '$basic_userId', 1, 0)"
      ]
    },
    {
      "name": "账号类别定义",
      "rules": [
        "安卓QQ: lower(attribute_info) REGEXP '安卓qq'",
        "苹果QQ: lower(attribute_info) REGEXP '苹果qq'",
        "其他: 不符合以上条件"
      ]
    },
    {
      "name": "实名类别定义",
      "rules": [
        "不可二次实名: attribute_info REGEXP '不可二次实名'",
        "可二次实名: attribute_info REGEXP '可二次实名'",
        "支持人脸包赔: attribute_info REGEXP '支持人脸包赔'",
        "其他: 不符合以上条件"
      ]
    },
    {
      "name": "价格区间定义",
      "rules": [
        "0-500: price / 100 <= 500",
        "500-1000: price / 100 <= 1000",
        "1000-1500: price / 100 <= 1500",
        "1500-2000: price / 100 <= 2000",
        "2000-2500: price / 100 <= 2500",
        "2500-3000: price / 100 <= 3000",
        "3000-3500: price / 100 <= 3500",
        "3500-4000: price / 100 <= 4000",
        "4000-4500: price / 100 <= 4500",
        "4500-5000: price / 100 <= 5000",
        ">5000: price / 100 > 5000"
      ]
    }
  ],
  "query_patterns": [
    {
      "name": "订单转化漏斗分析",
      "description": "分析从商品浏览到订单完单的转化过程",
